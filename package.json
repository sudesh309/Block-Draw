{
  "name": "obsidian-block-draw",
  "version": "0.6.0",
  "description": "Obsidian plugin for block diagrams: titled blocks, connections and linked frames, exportable to JSON, Google Sheets and Excel.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/check-budgets.mjs --bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && npm run lint:css && npm run lint:arch",
    "lint:css": "stylelint --max-warnings 0 styles.css",
    "lint:arch": "node scripts/check-layers.mjs && node scripts/check-budgets.mjs",
    "test": "vitest run",
    "test:ui": "node tests/harness/build-harness.mjs && node tests/harness/run-ui-tests.mjs",
    "test:e2e": "node tests/e2e/run-obsidian-e2e.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "diagram",
    "block diagram",
    "google sheets"
  ],
  "author": "sudesh309",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "playwright-core": "^1.63.0",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
